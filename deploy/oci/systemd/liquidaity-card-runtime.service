[Unit]
Description=LiquidAIty Card runtime gateway
After=network-online.target
Wants=network-online.target
PartOf=liquidaity.target

[Service]
Type=simple
User=liquidaity
Group=liquidaity
WorkingDirectory=/opt/liquidaity/HermesLatest
EnvironmentFile=/etc/liquidaity/liquidaity.env
Environment=HOME=/var/lib/liquidaity
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/liquidaity/HermesLatest/.venv/bin/python -X utf8 -m hermes_cli.main -p default serve --host 127.0.0.1 --port 9119 --skip-build
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=liquidaity.target
