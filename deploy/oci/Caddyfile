{
	admin off
	# IP clients omit SNI; Oracle's listener sees a private address behind NAT.
	default_sni {$LIQUIDAITY_DOMAIN}
	# Public IP certificates require Let's Encrypt's short-lived profile.
	cert_issuer acme {
		dir https://acme-v02.api.letsencrypt.org/directory
		profile shortlived
	}
	servers {
		# Only TCP 80/443: no HTTP/3 UDP listener.
		protocols h1 h2
	}
}

{$LIQUIDAITY_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 32MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	handle_path /product/* {
		reverse_proxy {$PRODUCT_HTTP_ORIGIN:127.0.0.1:4000} {
			flush_interval -1
		}
	}
	handle_path /worldview-native/* {
		route {
			# Existing Hermes authentication; successful GETs may rotate cookies.
			reverse_proxy {$HERMES_HTTP_ORIGIN:127.0.0.1:9120} {
				method GET
				rewrite /api/auth/me
				header_up -Connection
				header_up -Upgrade
				header_up X-Forwarded-Method {method}
				header_up X-Forwarded-Uri {uri}
				@authenticated status 2xx
				handle_response @authenticated {
					copy_response_headers {
						include Set-Cookie
					}
				}
			}
			reverse_proxy {$WORLDVIEW_HTTP_ORIGIN:127.0.0.1:4174} {
				header_up -Cookie
				header_up -Authorization
				header_up -X-Hermes-Session-Token
				flush_interval -1
			}
		}
	}
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy {$MCP_HTTP_ORIGIN:127.0.0.1:8765} {
			flush_interval -1
		}
	}
	# Hermes owns the UI, sign-in, /api/webapp, /api/ws and /api/pty.
	handle {
		reverse_proxy {$HERMES_HTTP_ORIGIN:127.0.0.1:9120} {
			flush_interval -1
		}
	}
}
