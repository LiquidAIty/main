# Copy to /etc/liquidaity/liquidaity.env, replace every <placeholder>, then chmod 0640.
# Values use systemd EnvironmentFile syntax. Quote values containing spaces or shell metacharacters.

# REQUIRED EXTERNAL OWNER VALUES
LIQUIDAITY_DOMAIN=<public-fqdn>
LIQUIDAITY_PUBLIC_BASE_URL=https://<public-fqdn>
CORS_ALLOWED_ORIGINS=https://<public-fqdn>
AUTH_BOOTSTRAP_TOKEN=<generated-random-bootstrap-token>

# FIXED PRODUCTION PROCESS SETTINGS
NODE_ENV=production
PORT=4000
LIQUIDAITY_REPO_ROOT=/opt/liquidaity
LIQUIDAITY_ENV_FILE=/etc/liquidaity/liquidaity.env
LIQUIDAITY_PRODUCT_CHAT_CWD=/var/lib/liquidaity/workspaces/main
BUILDER_PROJECT_CODE_ROOT=/var/lib/liquidaity/project-code
LIQUIDAITY_RUN_INPUT_ROOT=/var/lib/liquidaity/run-inputs
MAIN_BACKEND_URL=http://127.0.0.1:4000
PYTHON_RAILS_URL=http://127.0.0.1:8003
KNOWGRAPH_URL=http://127.0.0.1:8001
KNOWGRAPH_UPLOAD_MAX_FILE_SIZE_BYTES=26214400

# DATABASE AUTHORITIES
POSTGRES_DB=liquidaity
POSTGRES_USER=liquidaity-user
POSTGRES_PASSWORD=<generated-postgres-password>
DATABASE_URL=postgresql://liquidaity-user:<url-encoded-postgres-password>@127.0.0.1:5433/liquidaity
NEO4J_USER=neo4j
NEO4J_PASSWORD=<generated-neo4j-password>
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j

# GENERATED-ON-HOST INTERNAL SECRETS
LIQUIDAITY_INTERNAL_MCP_SECRET=<generated-at-least-32-random-characters>
LIQUIDAITY_INTERNAL_MCP_URL=http://127.0.0.1:8765/mcp
HERMES_HOME=/opt/liquidaity/HermesLatest/.hermes

# PUBLIC MCP AND OAUTH/AUTH0 OWNER VALUES
MCP_TRANSPORT=streamable-http
MCP_HTTP_PORT=8765
MCP_PUBLIC_RESOURCE_URL=https://<public-fqdn>/mcp
MCP_AUTH0_ISSUER_URL=https://<auth0-tenant>/
MCP_AUTH0_AUDIENCE=https://<public-fqdn>/mcp
MCP_AUTH0_CLIENT_ID=<auth0-client-id>
# MCP_AUTH0_CLIENT_SECRET=<auth0-client-secret-if-required>
MCP_AUTH0_REQUIRED_SCOPE=liquidaity.main
MCP_OAUTH_ENFORCED=true

# EXTERNAL CODEBASE MEMORY PREREQUISITE
# The repository owns no additional CBM daemon or systemd service. This command must already exist.
MCP_CBM_BINARY=codebase-memory-mcp

# OPTIONAL MODEL/RESEARCH PROVIDERS
# OPENAI_API_KEY=<optional-openai-api-key>
# OPENAI_BASE_URL=<optional-openai-compatible-base-url>
# OPENROUTER_API_KEY=<optional-openrouter-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL=<optional-openrouter-model-id>
# OPENROUTER_DEFAULT_KG_MODEL_KEY=<optional-knowgraph-model-id>
# ANTHROPIC_API_KEY=<optional-anthropic-api-key>
# TAVILY_API_KEY=<optional-tavily-api-key>
# SEC_API_KEY=<optional-sec-api-key>
# ALPACA_API_KEY_ID=<optional-paper-alpaca-key-id>
# ALPACA_API_SECRET_KEY=<optional-paper-alpaca-secret>
ALPACA_PAPER=true

# EXCLUDED DEVELOPMENT/OPTIONAL PRODUCTS
WORLDSIGNALS_ENABLED=false
# No ngrok, Shadowbroker, WorldSignals service, WorldView service, Project ID, or Run ID belongs here.
