# Runtime-only Compose interpolation file. Copy outside the checkout, mode 0600.
# Never pass this file to docker build or commit filled values.
# Single-quote filled values containing $ so Compose cannot expand credentials.
# Host/IP/DNS/OS/capacity are not verified; SSH audit is deferred to the owner.
LIQUIDAITY_DOMAIN=<verified-public-fqdn>
IMAGE_TAG=oracle-prep
HERMES_BASE_IMAGE=local/hermes-controlled:oracle-prep
HERMES_UID=10000
HERMES_GID=10000

# EXACT EXISTING database volumes from the host audit. No fresh authority is seeded.
POSTGRES_DATA_VOLUME=<existing-postgres-volume>
NEO4J_DATA_VOLUME=<existing-neo4j-data-volume>
NEO4J_LOGS_VOLUME=<existing-neo4j-logs-volume>
POSTGRES_DB=liquidaity
POSTGRES_USER=liquidaity-user
POSTGRES_PASSWORD=<retained-postgres-password>
DATABASE_URL=postgresql://liquidaity-user:<url-encoded-retained-password>@127.0.0.1:5433/liquidaity
NEO4J_USER=neo4j
NEO4J_PASSWORD=<retained-neo4j-password>
NEO4J_DATABASE=neo4j
LIQUIDAITY_INTERNAL_MCP_SECRET=<retained-signing-secret-at-least-32-characters>
AUTH_BOOTSTRAP_TOKEN=

# Pre-existing directories on a native Linux filesystem, correctly owned.
# Bind mounts refuse missing paths; the package never copies or initializes saved state.
HERMES_STATE_DIR=/var/lib/liquidaity/hermes
THINKGRAPH_STATE_DIR=/var/lib/liquidaity/thinkgraph-users
KNOWGRAPH_UPLOAD_DIR=/var/lib/liquidaity/knowgraph-uploads
WORKSPACE_STATE_DIR=/var/lib/liquidaity/workspaces-state
MODEL_CACHE_DIR=/var/lib/liquidaity/model-cache
WORLDVIEW_CACHE_DIR=/var/lib/liquidaity/worldview-cache

# Provider configuration is independent of each saved Card's model selection.
# OpenRouter was reported present/HTTP-200 in local preparation; it is a PAID
# account, not a free tier. That does not prove Oracle access or any model turn.
OPENROUTER_API_KEY=<existing-paid-openrouter-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KNOWGRAPH_PROVIDER=openrouter
KNOWGRAPH_MODEL=
KNOWGRAPH_EMBEDDING_MODEL=
# Missing locally at preparation. Do not substitute another provider/model.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_OPENAI_BASE_URL=
OPENROUTER_DEFAULT_KG_MODEL_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
TAVILY_API_KEY=
SEC_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
KNOWGRAPH_EMBEDDING_DIM=
KNOWGRAPH_OPENROUTER_EMBEDDING_MODEL=
KNOWGRAPH_OPENAI_EMBEDDING_MODEL=

# Provider server only. Missing optional keys mean those features are unavailable.
LL2_API_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
TFL_APP_KEY=
TOMTOM_API_KEY=
# Deliberately public browser tokens: also supply at build time if those map
# layers are required. Restrict the tokens to the final domain and needed assets.
CESIUM_ION_TOKEN=
GOOGLE_MAPS_API_KEY=

# External CodeGraph executable must be provided separately; absence is reported.
MCP_CBM_BINARY=codebase-memory-mcp
# No Auth0/OAuth MCP settings, ngrok, ShadowBroker or WorldMonitor service.
# Hermes sign-in and saved provider credentials remain in the retained Hermes home.
