{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "rootDir": "..",
    "noImplicitAny": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/types/hermes": [
        "../Hermes/apps/desktop/src/types/hermes.ts"
      ],
      "@/lib/time": [
        "../Hermes/apps/desktop/src/lib/time.ts"
      ]
    }
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts"
  ],
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../Hermes/apps/desktop/src/app/starmap/color.ts",
    "../Hermes/apps/desktop/src/app/starmap/constants.ts",
    "../Hermes/apps/desktop/src/app/starmap/geometry.ts",
    "../Hermes/apps/desktop/src/app/starmap/render.ts",
    "../Hermes/apps/desktop/src/app/starmap/simulation.ts",
    "../Hermes/apps/desktop/src/app/starmap/text.ts",
    "../Hermes/apps/desktop/src/app/starmap/time-axis.ts",
    "../Hermes/apps/desktop/src/app/starmap/types.ts",
    "../Hermes/apps/desktop/src/types/hermes.ts",
    "../Hermes/apps/desktop/src/lib/time.ts"
  ]
}
