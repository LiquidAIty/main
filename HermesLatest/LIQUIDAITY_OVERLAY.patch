+        callId="call-1",
+        tool="selected",
+        arguments={},
+    )
+
+    def interrupt() -> None:
+        assert entered.wait(timeout=2)
+        session.request_interrupt()
+
+    interrupter = threading.Thread(target=interrupt, daemon=True)
+    interrupter.start()
+    result = session.run_turn("Use the selected tool.", turn_timeout=2)
