+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+
+
+TEAM_PROFILE = "team"
+PARENT_PROVIDER = "openai-codex"
+PARENT_MODEL = "gpt-5.6-terra"
+WORKER_PROVIDER = "openai-codex"
+WORKER_MODEL = "gpt-5.6-luna"
