{
  "name": "main",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev:fresh",
    "dev:stop": "kill-port 4000 5173 8003 8001 8765 4040",
    "dev:fresh": "npm run dev:stop && concurrently --kill-others --kill-timeout 5000 --success all --names frontend,backend,autogen,knowgraph,mcp,tunnel --prefix-colors green,magenta,cyan,blue,white,gray \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:autogen\" \"npm run dev:knowgraph\" \"npm run dev:mcp\" \"npm run dev:tunnel\"",
    "dev:frontend": "npm --workspace client run dev -- --strictPort",
    "dev:backend": "npm --workspace apps/backend run serve",
    "dev:autogen": "apps\\python-models\\.venv\\Scripts\\python.exe -X utf8 -m uvicorn app.main:app --app-dir apps/python-models --host 127.0.0.1 --port 8003",
    "dev:knowgraph": "services\\knowgraph\\.venv\\Scripts\\python.exe -X utf8 -m uvicorn app:app --app-dir services/knowgraph --host 127.0.0.1 --port 8001",
    "dev:mcp": "set \"MCP_TRANSPORT=streamable-http\" && set \"MCP_HTTP_PORT=8765\" && set \"MCP_PUBLIC_RESOURCE_URL=%npm_package_config_mcp_public_resource_url%\" && set \"MCP_AUTH0_ISSUER_URL=https://dev-7up6xippkmhecz1j.us.auth0.com/\" && set \"MCP_AUTH0_AUDIENCE=%npm_package_config_mcp_public_resource_url%\" && set \"MCP_AUTH0_CLIENT_ID=xBb72662qIvqibSf7SdCJZm8G4cL28ud\" && set \"MCP_AUTH0_REQUIRED_SCOPE=liquidaity.main\" && set \"MCP_OAUTH_ENFORCED=true\" && set \"CBM_UI_ENABLED=true\" && set \"CBM_UI_PORT=9749\" && apps\\python-models\\.venv\\Scripts\\python.exe apps\\python-models\\app\\mcp_host.py",
    "dev:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mcp-tunnel.ps1 -PublicResourceUrl \"%npm_package_config_mcp_public_resource_url%\"",
    "dev:public": "concurrently --names mcp,tunnel --prefix-colors white,gray \"npm run dev:mcp\" \"npm run dev:tunnel\"",
    "dev:all": "npm run dev:fresh",
    "mcp:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-codebase-memory-mcp.ps1",
    "mcp:check": "powershell -ExecutionPolicy Bypass -File scripts/check-codebase-memory-mcp.ps1",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace apps/backend",
    "typecheck:spec": "npm run typecheck:spec --workspace client && npm run typecheck:spec --workspace apps/backend",
    "typecheck:all": "npm run typecheck && npm run typecheck:spec",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma --name init",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "vitest run"
  },
  "config": {
    "mcp_public_resource_url": "https://exemption-unstable-wolverine.ngrok-free.dev/mcp"
  },
  "private": true,
