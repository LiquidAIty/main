{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"require('node:fs').rmSync('apps/backend/dist',{recursive:true,force:true,maxRetries:5,retryDelay:200})\""
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["clean"],
      "outputs": ["{workspaceRoot}/apps/backend/dist"],
      "options": {
        "outputPath": "apps/backend/dist",
        "main": "apps/backend/src/main.ts",
        "tsConfig": "apps/backend/tsconfig.app.json",
        "assets": [
          {
            "glob": "*.md",
            "input": "apps/backend/src/decks/prompts",
            "output": "src/decks/prompts"
          }
        ],
        "clean": false
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  },
  "tags": []
}
