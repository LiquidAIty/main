FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

ARG CBM_VERSION=0.10.8
ARG CBM_RELEASE_SHA256=6EEF49652BC0C7820F43114125044D40BF7F4D97C11B2592F6B0F6A307702325
ARG CBM_BINARY_SHA256=1175645CB30560E7E47D78611CD1BCB509478EAF6D4E51F72FE18327EE9C1351

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

# Use the checksum-pinned release's own installer. It performs the complete
# stock installation and agent-detection/configuration pass inside the image.
# The Docker build has no host agent configuration mounted, so this cannot
# register a direct host or Codex CBM connection.
RUN set -eux; \
    release_dir="/tmp/codebase-memory-mcp-release"; \
    archive="${release_dir}/codebase-memory-mcp-linux-amd64-portable.tar.gz"; \
    release_url="https://github.com/DeusData/codebase-memory-mcp/releases/download/v${CBM_VERSION}"; \
    mkdir -p "${release_dir}"; \
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output "${archive}" \
        "${release_url}/codebase-memory-mcp-linux-amd64-portable.tar.gz"; \
    echo "${CBM_RELEASE_SHA256}  ${archive}" | sha256sum --check --strict; \
    tar -xzf "${archive}" -C "${release_dir}" \
        codebase-memory-mcp \
        install.sh \
        LICENSE \
        THIRD_PARTY_NOTICES.md; \
    echo "${CBM_BINARY_SHA256}  ${release_dir}/codebase-memory-mcp" \
        | sha256sum --check --strict; \
    chmod 0755 "${release_dir}/codebase-memory-mcp" "${release_dir}/install.sh"; \
    test "$("${release_dir}/codebase-memory-mcp" --version)" = "codebase-memory-mcp ${CBM_VERSION}"; \
    CBM_DOWNLOAD_URL="${release_url}" "${release_dir}/install.sh" --dir=/usr/local/bin; \
    test "$(/usr/local/bin/codebase-memory-mcp --version)" = "codebase-memory-mcp ${CBM_VERSION}"; \
    install -d /usr/share/doc/codebase-memory-mcp; \
    install -m 0644 "${release_dir}/LICENSE" /usr/share/doc/codebase-memory-mcp/LICENSE; \
    install -m 0644 "${release_dir}/THIRD_PARTY_NOTICES.md" \
        /usr/share/doc/codebase-memory-mcp/THIRD_PARTY_NOTICES.md; \
    rm -rf "${release_dir}"

LABEL org.opencontainers.image.title="CodeGraph" \
      org.opencontainers.image.version="${CBM_VERSION}" \
      org.opencontainers.image.source="https://github.com/DeusData/codebase-memory-mcp" \
      org.opencontainers.image.revision="46ae198fc11cda80e817acbc5f5908d7c2de7032" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /C/Projects/LiquidAIty/main

# The application Python MCP host opens the one long-lived stock CBM stdio
# frontend. The upstream binary owns its daemon, watcher, and graph lifecycle.
CMD ["tail", "-f", "/dev/null"]
