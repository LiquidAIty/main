# Secrets / private local config
.env
.env.*
!.env.example
*.pem

# Default owned Local Coder workspace (handoff prompts, returned model artifacts,
# and the Coder's own generated repos/apps) — never part of the LiquidAIty app repo.
/coder-workspace/

# Repo-local Hermes runtime data. Source lives visibly in /Hermes, while
# profiles, credentials, sessions, databases, caches, backups, and the rebuilt
# virtual environment stay local and must never be committed.
/Hermes/.hermes/
/Hermes/venv/
coder-workspace/handoff/
coder-workspace/returns/

# Local proof/model artifacts
tmp_*.json
tmp_*.log
handoff/
db/thinkgraph-engraphis-v2.sqlite*
# Reproducible Engraphis release-check cache stored beside the local database.
/db/.engraphis_update_check.json
# Runtime copies of user-uploaded KnowGraph documents. The original user files
# remain outside the repo and the service recreates these copies on ingestion.
/services/knowgraph/uploads/

# Dependency folders
node_modules/

# Build artifacts
*.tsbuildinfo
**/node_modules/
.pnp
.pnp.js

# Generated build/cache output
dist/
**/dist/
build/
**/build/
.next/
**/.next/
.nx/cache/
**/.nx/cache/
.nx/workspace-data/
out/
out-tsc/
tmp/

# Repo-owned native Codebase Memory runtime. The pinned setup script restores
# the platform binary; the graph cache is rebuilt through native MCP tools.
/.tools/codebase-memory-mcp/bin/
/.codebase-memory/index/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Python rebuildable junk
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]

# Test/cache output
coverage/
test-output/
test-results/
.codex-temp/
apps/backend/env

# Agent-local auth/cache files
.agents/**/.env
.agents/**/auth*
.agents/**/token*
.agents/**/credentials*

# Backend-generated local users/sessions. Runtime identity lives in the active
# database/auth provider; these machine-local JSON artifacts are not source.
/apps/backend/.data/


autogen-main/
/neo4j-text2cypher/
/defog-sqlcoder/

# WorldSignals embed bundle - built from worldsignal/Shadowbroker-main/frontend (npm run build:embed)
client/public/worldsignals/

# Upstream LFS model was not distributed with the source archive
/worldsignal/Shadowbroker-main/backend/data/drishx/rf_model.pickle

# Python caches
.pytest_cache/
.ruff_cache/

