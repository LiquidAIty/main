# LiquidAIty Input Data Definition
#
# One repository-owned catalog for the structured records and mixed-language
# islands that may appear inside a LiquidAIty IDF. The file uses TOML syntax so
# Python rails can interpret it with the standard library. It is not JSON, and
# TypeScript/Python contain no generated copy of these definitions.

[dictionary]
name = "LiquidAIty"
version = 2
idfFormat = "mixed-markdown"
islandStyle = "bracketed-native-language"
unknownIslands = "inert"

# Relationship vocabulary. React Flow authors the instances and Python rails
# validates them before AGE persists them. These declarations are not seeds and
# do not create or infer any relationship.
[[relationships]]
name = "FLOW"
canvasValue = "flow"
authority = "AGE"
direction = "source-to-target"

[[relationships]]
name = "MAGENTIC_OPTION"
canvasValue = "magentic_option"
authority = "AGE"
direction = "source-to-target"

[[relationships]]
name = "MAGENTIC_CONTROL"
canvasValue = "magentic_control"
authority = "AGE"
direction = "source-to-target"

[dictionary.markdown]
looseTextDefault = true
commonContent = [
  "current task",
  "dynamic context",
  "search terms",
  "handoffs",
  "returned summaries",
  "ordinary reasoning and instructions",
]

[[catalogs]]
name = "configured-models"
record = "model-option"
authority = "LiquidAIty.idd"
entries = "models"
liveCheck = "availability-and-contract-only"
identityFields = ["provider", "key"]

[[catalogs]]
name = "native-tools"
record = "tool-catalog-reference"
authority = "LiquidAIty.idd"
entries = "toolGroups.tools"
liveCheck = "availability-and-contract-only"
identityFields = ["canonicalId"]
sources = [
  "LiquidAIty custom MCP tools",
  "Codebase Memory / CodeGraph MCP",
  "Engraphis / ThinkGraph MCP",
  "Graphiti / KnowGraph MCP",
  "private AutoGen and specialist runtime tools",
]

# Permanent model vocabulary. Runtime configuration decides whether a declared
# model is currently available and which declared model is the local default;
# it may not introduce an undeclared card choice.

[[models]]
provider = "openai"
key = "gpt-5.6-sol"
label = "GPT-5.6 Sol"
providerModelId = "gpt-5.6-sol"

[[models]]
provider = "openai"
key = "gpt-5.6-terra"
label = "GPT-5.6 Terra"
providerModelId = "gpt-5.6-terra"

[[models]]
provider = "openai"
key = "gpt-5.6-luna"
label = "GPT-5.6 Luna"
providerModelId = "gpt-5.6-luna"

[[models]]
provider = "openrouter"
key = "or-google-gemini-2.5-pro"
label = "OpenRouter Gemini 2.5 Pro"
providerModelId = "google/gemini-2.5-pro"

[[models]]
provider = "openrouter"
key = "google/gemini-2.5-pro"
label = "OpenRouter Gemini 2.5 Pro (Direct ID)"
providerModelId = "google/gemini-2.5-pro"

[[models]]
provider = "openrouter"
key = "or-deepseek-chat"
label = "OpenRouter DeepSeek Chat"
providerModelId = "deepseek/deepseek-chat"

[[models]]
provider = "openrouter"
key = "deepseek/deepseek-chat"
label = "OpenRouter DeepSeek Chat (Direct ID)"
providerModelId = "deepseek/deepseek-chat"

[[models]]
provider = "openrouter"
key = "deepseek/deepseek-v4-flash-0731"
label = "OpenRouter DeepSeek V4 Flash 0731"
providerModelId = "deepseek/deepseek-v4-flash-0731"

[[models]]
provider = "openrouter"
key = "z-ai/glm-5.2"
label = "OpenRouter Z.ai GLM 5.2"
providerModelId = "z-ai/glm-5.2"

# Permanent tool vocabulary. These are tool declarations only: names,
# descriptions, explicit permission requirements, and native source identities. No CodeGraph,
# ThinkGraph, or KnowGraph node, edge, memory, episode, or fact is stored here.

[[toolGroups]]
namespace = "main"
namePrefix = ""
sourceId = "main_mcp"
kind = "tool"
publication = "external-mcp"

[[toolGroups.tools]]
name = "main.context"
displayName = "Main context"
description = "Read server-owned Main request and saved-card identities."
parameters = []
required = []

[[toolGroups.tools]]
name = "agentgraph.inspect"
displayName = "Inspect AgentGraph"
description = "Read bounded Project-scoped Card relationships and available AGE run, attention, lineage, tool, and artifact telemetry."
parameters = ["projectId", "deckId", "conversationId", "runId", "assignmentId", "limit", "projectWide"]
required = []

[[toolGroups.tools]]
name = "mag_one.describe_connected_agents"
displayName = "Describe connected Mag One agents"
description = "Read saved bus-eligible Mag One card capabilities."
parameters = ["projectId", "deckId"]
required = ["projectId"]

[[toolGroups.tools]]
name = "run_mag_one"
displayName = "Run Magentic-One"
description = "Load one canonical saved Mag One IDF and invoke its native runtime after current authority validation."
parameters = ["projectId", "deckId", "idfId", "conversationId"]
required = ["idfId", "projectId", "deckId"]
requiredCallerRuntimeKind = "hermes"
requiredCallerRuntimeMode = "main"

[[toolGroups.tools]]
name = "write_mag_one_instructions"
displayName = "Write Mag One instructions"
description = "Persist exact proposed Mag One instructions as one canonical saved IDF without starting a runtime."
parameters = ["projectId", "deckId", "conversationId", "instructions"]
required = ["instructions"]

[[toolGroups.tools]]
name = "canvas.inspect"
displayName = "Inspect canvas"
description = "Read a bounded saved card and wire view."
parameters = ["projectId", "deckId"]
required = ["projectId", "deckId"]

[[toolGroups.tools]]
name = "card.update_configuration"
displayName = "Update card configuration"
description = "Update the strict allowlist of saved card configuration fields."
parameters = ["projectId", "deckId", "cardId", "updates"]
required = ["projectId", "deckId", "cardId", "updates"]

[[toolGroups.tools]]
name = "canvas.upsert_wire"
displayName = "Upsert canvas wire"
description = "Create, update, or remove one saved flow or Mag One option wire."
parameters = ["projectId", "deckId", "op", "wire"]
required = ["projectId", "deckId", "op", "wire"]

[[toolGroups.tools]]
name = "web_search"
displayName = "Web search"
description = "Search the live web through the configured provider."
parameters = ["query", "max_results"]
required = ["query"]

[[toolGroups.tools]]
name = "card.run_assistant_agent"
displayName = "Run saved Card"
description = "Run one saved external Card through current Card grants and AGE relationship authority."
parameters = ["projectId", "deckId", "cardId", "correlationId", "conversationId", "originatingAgentId", "originatingRunId", "input"]
required = ["cardId", "input"]

