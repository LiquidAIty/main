required = false

[[records.fields]]
name = "requiredCallerRuntimeMode"
type = "string"
required = false

# These definitions drive the existing card editor. Options from a catalog are
# materialized from that catalog's native authority and validated above; they
# are not copied into this file as stale provider/tool inventories.

[[editorFields]]
name = "runtimeKind"
label = "Runtime"
path = "runtime.kind"
control = "select"
allowUnset = false
help = "Choose the one runtime owner for this saved Card."

[[editorFields.options]]
value = "hermes"
label = "Hermes"

[[editorFields.options]]
value = "autogen"
label = "AutoGen"

[[editorFields]]
name = "runtimeMode"
label = "Runtime mode"
path = "runtime.mode"
control = "select"
allowUnset = false
help = "Hermes supports Main, Delegate, and Kanban; AutoGen supports Assistant and Magentic-One."

[[editorFields.options]]
value = "main"
label = "Main"

[[editorFields.options]]
value = "delegate"
label = "Delegate"

[[editorFields.options]]
value = "kanban"
label = "Kanban"

[[editorFields.options]]
value = "assistant"
label = "Assistant"

[[editorFields.options]]
value = "magentic_one"
label = "Magentic-One"

[[editorFields]]
name = "runtimeProfile"
label = "Hermes profile"
path = "runtime.profile"
control = "text"
allowUnset = true
help = "Required for Hermes Cards and absent for AutoGen Cards."

[[editorFields]]
name = "provider"
label = "Provider"
path = "provider"
control = "select"
allowUnset = true
catalog = "configured-models"
help = "Only providers with current configured model choices are shown."

[[editorFields.options]]
value = "openai"
label = "OpenAI Account"

[[editorFields.options]]
value = "openrouter"
label = "OpenRouter"

[[editorFields]]
name = "accessMode"
label = "Access mode"
path = "runtimeOptions.accessMode"
control = "select"
allowUnset = false
help = "Select account transport or an explicit API credential mode; credentials remain centrally owned."

[[editorFields.options]]
value = "chatgpt-account"
label = "ChatGPT account"

[[editorFields.options]]
value = "openai-api"
label = "OpenAI API"

[[editorFields.options]]
value = "openrouter-api"
label = "OpenRouter API"

[[editorFields]]
name = "modelKey"
label = "Model"
path = "modelKey"
control = "catalog-select"
allowUnset = true
catalog = "configured-models"
filteredBy = "provider"

[[editorFields]]
name = "reasoningEffort"
label = "Reasoning"
path = "runtimeOptions.reasoningEffort"
control = "select"
allowUnset = true

[[editorFields.options]]
value = "low"
label = "Low"

[[editorFields.options]]
value = "medium"
label = "Medium"

[[editorFields.options]]
value = "high"
label = "High"

[[editorFields.options]]
value = "xhigh"
label = "Extra high"

[[editorFields]]
name = "temperature"
label = "Temperature"
path = "runtimeOptions.temperature"
control = "number"
allowUnset = true
minimum = 0.0
step = 0.1

[[editorFields]]
name = "maxTokens"
label = "Max tokens"
path = "runtimeOptions.maxTokens"
control = "integer"
allowUnset = true
minimum = 1
step = 1

[[editorFields]]
name = "maxTurns"
label = "Max turns"
path = "runtimeOptions.maxTurns"
control = "integer"
allowUnset = true
minimum = 1
step = 1

[[editorFields]]
name = "tools"
label = "Tools"
path = "tools"
control = "catalog-multiselect"
allowUnset = true
catalog = "native-tools"

[[islands]]
name = "SYSTEM"
language = "markdown"
repeatable = false

[[islands]]
name = "CARD"
language = "loose-key-values"
repeatable = false

[[islands]]
name = "SQL"
language = "sql"
repeatable = true
execution = "not-wired"

[[islands]]
name = "CYPHER"
language = "cypher"
repeatable = true
execution = "not-wired"

[[islands]]
name = "MCP"
language = "loose-key-values"
repeatable = true
execution = "native-catalog-required"

[[islands]]
name = "SCRIPT"
language = "attribute-selected"
repeatable = true
allowedAttributes = ["language"]
requiredAttributes = ["language"]
execution = "not-wired"

[[islands]]
name = "JSON"
language = "json"
repeatable = true

[[islands]]
name = "SEARCH_TERMS"
language = "text"
repeatable = true

[[islands]]
name = "KNOWN_CONTEXT"
language = "markdown"
repeatable = true

[[islands]]
name = "RETURN"
language = "markdown"
repeatable = true
