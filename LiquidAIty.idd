# Input Data Dictionary: composable Agent Builder data, not runtime authority.
# Main obtains user agreement; Builder under Chat builds Cards in Agent Builder mode.
# Tool owners supply their current catalogs. Saved Cards retain selected instances.
# Catalogs and executable validation are referenced rather than copied.

relationships = [
  { name = "FLOW", canvasValue = "flow", authority = "AGE", direction = "source-to-target" },
  { name = "MAGENTIC_OPTION", canvasValue = "magentic_option", authority = "AGE", direction = "source-to-target" },
]

[dictionary]
name = "LiquidAIty"
version = 5
purpose = "agent-builder"
source = "LiquidAIty.idd"
ordinaryText = "markdown"

# Builder-owned types compose; executable boundary types are referenced, not copied.
[types.Text]
kind = "primitive"
python = "str"
[types.Number]
kind = "primitive"
python = "float"
[types.Integer]
kind = "primitive"
python = "int"
[types.Boolean]
kind = "primitive"
python = "bool"
[types.Duration]
kind = "numeric"
base = "Number"
unit = "seconds"
minimum = 0
[types.Percent]
kind = "numeric"
base = "Number"
unit = "percent"
minimum = 0
maximum = 100
[types.Mission]
kind = "record"
fields = [{ id = "text", type = "Text", required = true }]
[types.InstructionsObject]
kind = "record"
fields = [{ id = "stable", type = "Text", required = true }]
[types.OutputContract]
kind = "record"
fields = [{ id = "text", type = "Text", required = true }]
[types.FileRef]
kind = "reference"
owner = "selected-file"
fields = [{ id = "path", type = "Text", required = true }]
[types.ImageRef]
kind = "reference"
owner = "selected-image"
fields = [{ id = "id", type = "Text", required = true }]
[types.GraphReference]
kind = "boundary"
source = "app.python_models.orchestration_contracts.GraphReference"
[types.AgentObject]
kind = "boundary"
source = "app.python_models.idf.StableSavedCardContext"
[types.ContextObject]
kind = "boundary"
source = "app.python_models.idf.ActualGraphData"
[types.RuntimeObject]
kind = "boundary"
source = "app.python_models.orchestration_contracts.HermesRuntime"

# Stable IDs determine variable names, independently of their display labels.
[objects.mission]
type = "Mission"
cardinality = "required"
label = "Mission"
[objects.agent]
type = "AgentObject"
cardinality = "required"
label = "Saved Card"
[objects.instructions]
type = "InstructionsObject"
cardinality = "required"
label = "Instructions"
[objects.context]
type = "ContextObject"
cardinality = "required"
label = "Selected context"
[objects.files]
type = "FileRef"
cardinality = "repeatable"
label = "Selected files"
[objects.images]
type = "ImageRef"
cardinality = "repeatable"
label = "Selected images"
[objects.output]
type = "OutputContract"
cardinality = "required"
label = "Output"

# Template IDs select composable object sets, never a provider, grant or runtime fallback.
[templates.template_assist]
label = "Custom assistant"
runtime = { kind = "hermes", mode = "delegate" }
objects = ["mission", "agent", "instructions", "context", "files", "images", "output"]
[templates.template_main_chat]
label = "Main"
runtime = { kind = "hermes", mode = "main" }
extends = "template_assist"
[templates.template_knowgraph]
label = "KnowGraph"
extends = "template_assist"
[templates.template_magentic]
label = "Magnetic"
runtime = { kind = "hermes", mode = "magentic_one", profile = "card_magentic" }
extends = "template_assist"
[templates.template_worldsignals_agent]
label = "WorldSignals"
extends = "template_assist"
[templates.template_trading_workbench]
label = "Trading"
extends = "template_assist"

[cardEditor]
tabs = ["Results", "Prompt", "Runtime", "Memory", "Tools"]
fields = [
  { name = "provider", label = "Provider", section = "Runtime", path = "runtimeOptions.provider", source = "CardConfiguration.provider", catalog = "configured-models", catalogProperty = "provider" },
  { name = "orchestrator", label = "Orchestrator", section = "Prompt", path = "runtimeOptions.orchestrator", source = "CardConfiguration.orchestrator", control = "checkbox", allowUnset = false, visibleWhen = { runtimeKind = "hermes" } },
  { name = "subagentType", label = "Subagents", section = "Runtime", path = "runtimeOptions.subagentType", source = "CardConfiguration.subagentType", allowUnset = false, visibleWhen = { runtimeKind = "hermes" } },
  { name = "accessMode", label = "Access", section = "Runtime", path = "runtimeOptions.accessMode", source = "CardConfiguration.accessMode", allowUnset = false },
  { name = "modelKey", label = "Model", section = "Runtime", path = "runtimeOptions.modelKey", source = "CardConfiguration.modelKey", catalog = "configured-models", control = "catalog-select", filteredBy = "provider" },
  { name = "autoSelect", label = "Auto-select model", section = "Runtime", path = "runtimeOptions.autoSelect", source = "CardConfiguration.autoSelect", control = "checkbox", allowUnset = false, visibleWhen = { runtimeKind = "hermes" } },
  { name = "jevModelChoiceContext", label = "Model-choice context", section = "Runtime", path = "runtimeOptions.jevContext.modelChoice", source = "CardConfiguration.jevModelChoiceContext", allowUnset = false, visibleWhen = { runtimeKind = "hermes" } },
  { name = "jevAutoToolsContext", label = "Auto-tools context", section = "Runtime", path = "runtimeOptions.jevContext.autoTools", source = "CardConfiguration.jevAutoToolsContext", allowUnset = false, visibleWhen = { runtimeKind = "hermes" } },
  { name = "reasoningEffort", label = "Reasoning", section = "Runtime", path = "runtimeOptions.reasoningEffort", source = "CardConfiguration.reasoningEffort" },
  { name = "temperature", label = "Temperature", section = "Runtime", path = "runtimeOptions.temperature", source = "CardConfiguration.temperature", step = 0.1 },
  { name = "maxTokens", label = "Max tokens", section = "Runtime", path = "runtimeOptions.maxTokens", source = "CardConfiguration.maxTokens", step = 1 },
  { name = "maxTurns", label = "Max turns", section = "Runtime", path = "runtimeOptions.maxTurns", source = "CardConfiguration.maxTurns", step = 1 },
  { name = "tools", label = "Tools", section = "Tools", path = "runtimeOptions.tools", source = "CardConfiguration.tools", catalog = "tools", control = "catalog-multiselect" },
  { name = "autoTools", label = "Auto-tools", section = "Tools", path = "runtimeOptions.autoTools", source = "CardConfiguration.autoTools", control = "checkbox", allowUnset = false, visibleWhen = { runtimeKind = "hermes" } },
  { name = "subagentModel", label = "Subagent model", section = "Runtime", path = "runtimeOptions.subagentModel", source = "CardConfiguration.subagentModel", catalog = "configured-models", control = "catalog-select", visibleWhen = { runtimeKind = "hermes" } },
]

[cardEditor.schemas]
CardConfiguration = "app.python_models.orchestration_contracts.CardConfiguration"
HermesRuntime = "app.python_models.orchestration_contracts.HermesRuntime"
