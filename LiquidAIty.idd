# Input Data Dictionary: composable Agent Builder data, not runtime authority.
# Main obtains user agreement; Coder under Chat builds Cards in Agent Builder mode.
# Native owners supply their current catalogs. Saved Cards retain selected instances.
# No credentials, model list, MCP schema copy, UI control catalog, or IDF validator here.
relationships = [
  { name = "FLOW", canvasValue = "flow", authority = "AGE", direction = "source-to-target" },
  { name = "MAGENTIC_OPTION", canvasValue = "magentic_option", authority = "AGE", direction = "source-to-target" },
  { name = "MAGENTIC_CONTROL", canvasValue = "magentic_control", authority = "AGE", direction = "source-to-target" },
]

# LiquidAIty publication/effect annotations only. These are not installed-tool declarations
# or grants. The existing host consumes this small projection at startup.
